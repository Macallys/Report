@startuml bc-01-plant-monitoring-domain
' Bounded Context Domain Layer Class Diagram — Plant Monitoring (§ 4.2.1.6.1)
' Fuente: BCC-01 (.cursor/design/bounded-context-canvas/01-plant-monitoring.md), paso 9 ES (A-04 … A-07).
' Lecturas CO₂ / ruido / presencia no unificadas; persistencia PostgreSQL (DEC-008).

skinparam classAttributeIconSize 0

enum DeviceKind {
  Sensor
  Actuator
}

enum PresenceState {
  Detected
  Cleared
}

class AreaName <<Value Object>> {
  -value: String
  +equals(other: AreaName): Boolean
}

class Location <<Value Object>> {
  -value: String
  +equals(other: Location): Boolean
}

class Co2Limit <<Value Object>> {
  -ppm: Decimal
  +equals(other: Co2Limit): Boolean
}

class NoiseLimit <<Value Object>> {
  -db: Decimal
  +equals(other: NoiseLimit): Boolean
}

class DeviceId <<Value Object>> {
  -value: String
  +equals(other: DeviceId): Boolean
}

class Co2Ppm <<Value Object>> {
  -value: Decimal
  +isValid(): Boolean
}

class NoiseDb <<Value Object>> {
  -value: Decimal
}

class IndustrialArea <<Aggregate Root>> {
  -id: UUID
  -name: AreaName
  -location: Location
  +register(name: AreaName, location: Location): IndustrialArea
  +update(name: AreaName, location: Location): void
  +updateSystemConfiguration(): void
}

class AreaThresholds <<Aggregate Root>> {
  -id: UUID
  -areaId: UUID
  -co2Limit: Co2Limit
  -noiseLimit: NoiseLimit
  +configure(area: IndustrialArea, co2Limit: Co2Limit, noiseLimit: NoiseLimit): AreaThresholds
  +update(co2Limit: Co2Limit, noiseLimit: NoiseLimit): void
}

class AreaDeviceAssignment <<Aggregate Root>> {
  -id: UUID
  -areaId: UUID
  -deviceId: DeviceId
  -kind: DeviceKind
  +associate(area: IndustrialArea, deviceId: DeviceId, kind: DeviceKind): AreaDeviceAssignment
}

class AreaTelemetry <<Aggregate Root>> {
  -id: UUID
  -areaId: UUID
  +recordCarbonDioxide(deviceId: DeviceId, ppm: Co2Ppm, recordedAt: DateTime): CarbonDioxideReading
  +recordNoise(deviceId: DeviceId, db: NoiseDb, recordedAt: DateTime): NoiseReading
  +recordPresence(deviceId: DeviceId, state: PresenceState, recordedAt: DateTime): PresenceChange
  +acceptIngest(): void
  +rejectIngest(): void
  +acknowledgeDuplicate(): void
  +markSensorUnavailable(deviceId: DeviceId): void
}

class CarbonDioxideReading <<Entity>> {
  -id: UUID
  -deviceId: DeviceId
  -ppm: Co2Ppm
  -recordedAt: DateTime
}

class NoiseReading <<Entity>> {
  -id: UUID
  -deviceId: DeviceId
  -db: NoiseDb
  -recordedAt: DateTime
}

class PresenceChange <<Entity>> {
  -id: UUID
  -deviceId: DeviceId
  -state: PresenceState
  -recordedAt: DateTime
}

interface IIndustrialAreaRepository <<Repository>> {
  +findById(id: UUID): IndustrialArea
  +findByName(name: AreaName): IndustrialArea
  +save(area: IndustrialArea): void
}

interface IAreaThresholdsRepository <<Repository>> {
  +findByAreaId(areaId: UUID): AreaThresholds
  +save(thresholds: AreaThresholds): void
}

interface IAreaDeviceAssignmentRepository <<Repository>> {
  +findByDeviceId(deviceId: DeviceId): AreaDeviceAssignment
  +save(assignment: AreaDeviceAssignment): void
}

interface IAreaTelemetryRepository <<Repository>> {
  +findLatestByAreaId(areaId: UUID): AreaTelemetry
  +save(telemetry: AreaTelemetry): void
}

interface IDomainEventPublisher <<Port>> {
  +publish(event: DomainEvent): void
}

IndustrialArea "1" -- "0..1" AreaThresholds : configures >
IndustrialArea "1" -- "0..*" AreaDeviceAssignment : assigns >
IndustrialArea "1" -- "1" AreaTelemetry : records >

IndustrialArea *-- "1" AreaName
IndustrialArea *-- "1" Location
AreaThresholds *-- "1" Co2Limit
AreaThresholds *-- "1" NoiseLimit
AreaDeviceAssignment *-- "1" DeviceId
AreaDeviceAssignment *-- "1" DeviceKind

AreaTelemetry "1" *-- "0..*" CarbonDioxideReading : contains >
AreaTelemetry "1" *-- "0..*" NoiseReading : contains >
AreaTelemetry "1" *-- "0..*" PresenceChange : contains >
CarbonDioxideReading *-- "1" Co2Ppm
CarbonDioxideReading *-- "1" DeviceId
NoiseReading *-- "1" NoiseDb
NoiseReading *-- "1" DeviceId
PresenceChange *-- "1" PresenceState
PresenceChange *-- "1" DeviceId

IIndustrialAreaRepository ..> IndustrialArea : manages
IAreaThresholdsRepository ..> AreaThresholds : manages
IAreaDeviceAssignmentRepository ..> AreaDeviceAssignment : manages
IAreaTelemetryRepository ..> AreaTelemetry : manages
AreaTelemetry ..> IDomainEventPublisher : publishes

@enduml
