@startuml bc-02-safety-actuation-database
' Bounded Context Database Design Diagram — Safety & Actuation (§ 4.2.2.6.2)
' Modelo relacional lógico; motor TBD. Sin device_id: (area_id, actuator_type) es el relé lógico.
' DEC-007: mismos hechos en Edge Database (loop vivo) y Cloud Database (sync/auditoría).
' No copiar estas tablas al esquema de Device & Edge.

package "Edge Database (live loop)" {
  entity "exposure_states" as exposure_states_edge {
    * id : UUID <<PK>>
    --
    * area_id : UUID <<UNIQUE>>
    * personnel_present : BOOLEAN
    * severity : VARCHAR
    * risk_highlighted : BOOLEAN
    * alert_active : BOOLEAN
    * updated_at : TIMESTAMP
  }

  entity "environmental_alerts" as environmental_alerts_edge {
    * id : UUID <<PK>>
    --
    * exposure_state_id : UUID <<FK>>
    * area_id : UUID
    * raised_at : TIMESTAMP
    withdrawn_at : TIMESTAMP
  }

  entity "area_actuator_states" as area_actuator_states_edge {
    * id : UUID <<PK>>
    --
    * area_id : UUID
    * actuator_type : VARCHAR
    * run_state : VARCHAR
    * mode : VARCHAR
    * last_changed_at : TIMESTAMP
  }

  entity "automatic_actuator_actions" as automatic_actuator_actions_edge {
    * id : UUID <<PK>>
    --
    * area_id : UUID
    * actuator_type : VARCHAR
    * succeeded : BOOLEAN
    * recorded_at : TIMESTAMP
  }

  exposure_states_edge ||--o{ environmental_alerts_edge : "1 state has many alerts"
}

package "Cloud Database (sync / audit)" {
  entity "exposure_states" as exposure_states_cloud {
    * id : UUID <<PK>>
    --
    * area_id : UUID <<UNIQUE>>
    * personnel_present : BOOLEAN
    * severity : VARCHAR
    * risk_highlighted : BOOLEAN
    * alert_active : BOOLEAN
    * updated_at : TIMESTAMP
  }

  entity "environmental_alerts" as environmental_alerts_cloud {
    * id : UUID <<PK>>
    --
    * exposure_state_id : UUID <<FK>>
    * area_id : UUID
    * raised_at : TIMESTAMP
    withdrawn_at : TIMESTAMP
  }

  entity "area_actuator_states" as area_actuator_states_cloud {
    * id : UUID <<PK>>
    --
    * area_id : UUID
    * actuator_type : VARCHAR
    * run_state : VARCHAR
    * mode : VARCHAR
    * last_changed_at : TIMESTAMP
  }

  entity "automatic_actuator_actions" as automatic_actuator_actions_cloud {
    * id : UUID <<PK>>
    --
    * area_id : UUID
    * actuator_type : VARCHAR
    * succeeded : BOOLEAN
    * recorded_at : TIMESTAMP
  }

  exposure_states_cloud ||--o{ environmental_alerts_cloud : "1 state has many alerts"
}

@enduml
